---
import Timeline from '../../components/Timeline.astro';
import { prepareEpisodeHtml } from '../../lib/episode-notes';
import { getEpisodes } from '../../lib/episodes';
import EpisodeLayout from '../../layouts/Episode.astro';

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  return episodes.map((episode) => ({
    params: { slug: episode.data.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const html = episode.rendered?.html;
if (!html) throw new Error(`Missing rendered HTML for episode ${episode.data.slug}.`);
const headings = episode.rendered?.metadata?.headings ?? [];
const { parts, timelines } = prepareEpisodeHtml(html);
---

<EpisodeLayout episode={episode} headings={headings}>
  {
    parts.map((part, index) => (
      <>
        <Fragment set:html={part} />
        {timelines[index] && <Timeline items={timelines[index]} />}
      </>
    ))
  }
</EpisodeLayout>
