---
import Base from '../../layouts/Base.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { allTags, getEpisodes } from '../../lib/episodes';

const episodes = await getEpisodes();
const tags = allTags(episodes);
const description = 'Every Intelligence Adjacent episode, newest first. The video is the short version. These notes are the rest.';
---

<Base title="Episodes" description={description}>
  <p class="kicker">Show notes</p>
  <h1>Episodes</h1>
  <p class="lede">{description}</p>
  {
    tags.length > 0 && (
      <div class="filters" data-episode-filter role="group" aria-label="Filter by tag">
        <button type="button" class="filter-button" data-filter="" aria-pressed="true">
          All
        </button>
        {tags.map((tag) => (
          <button type="button" class="filter-button" data-filter={tag} id={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
    )
  }
  {
    episodes.length > 0 && (
      <p class="filter-count" data-count aria-live="polite">
        {episodes.length === 1 ? '1 episode' : `${episodes.length} episodes`}
      </p>
    )
  }
  <p data-empty hidden>No episodes with that tag.</p>
  {
    episodes.length === 0 ? (
      <p class="empty-state">First episode coming soon.</p>
    ) : (
      <div class="cards" data-episode-list>
        {episodes.map((episode) => (
          <div data-tags={episode.data.tags.join(' ')}>
            <EpisodeCard episode={episode} />
          </div>
        ))}
      </div>
    )
  }
</Base>

<script>
  function setupFilters() {
    const root = document.querySelector<HTMLElement>('[data-episode-filter]');
    const list = document.querySelector<HTMLElement>('[data-episode-list]');
    if (!root || !list) return;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...list.querySelectorAll<HTMLElement>('[data-tags]')];
    const count = document.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    const apply = (tag: string) => {
      let visible = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags ?? '').split(' ').filter(Boolean);
        const show = tag === '' || tags.includes(tag);
        item.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String((button.dataset.filter ?? '') === tag));
      });
      if (count) {
        const noun = visible === 1 ? 'episode' : 'episodes';
        count.textContent = tag ? `${visible} ${noun}` : `${items.length} ${items.length === 1 ? 'episode' : 'episodes'}`;
      }
      if (empty) empty.hidden = visible !== 0;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.filter ?? '';
        apply(tag);
        const next = tag ? `#${tag}` : ' ';
        history.replaceState(null, '', tag ? next : window.location.pathname);
      });
    });

    const fromHash = window.location.hash.replace('#', '');
    if (fromHash && buttons.some((button) => button.dataset.filter === fromHash)) {
      apply(fromHash);
    }
  }

  setupFilters();
</script>
