---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const description =
  'Privacy policy for Intelligence Adjacent. The site sets no cookies or trackers. Email, Ko-fi, and the YouTube upload tool are described here.';
---

<Base title="Privacy" description={description}>
  <p class="kicker">Effective November 24, 2026</p>
  <h1>Privacy</h1>
  <div class="prose narrow">
    <h2>This website</h2>
    <p>
      {site.name} is a static website on GitHub Pages. It sets no cookies of its own, and it runs no analytics
      or other trackers. There is no account, no comment box, and no sign-up form.
    </p>
    <h2>GitHub</h2>
    <p>
      GitHub serves the pages. It may record basic request data, such as an IP address and a browser, under the
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub Privacy Statement</a>.
    </p>
    <h2>Email</h2>
    <p>
      Mail sent to <a href={`mailto:${site.email}`}>{site.email}</a> is used only to reply and to make corrections.
      It is not sold, and it is not added to a mailing list.
    </p>
    <h2>Ko-fi</h2>
    <p>
      Support payments go through Ko-fi. Ko-fi and its payment processors handle that payment under
      <a href="https://more.ko-fi.com/privacy">Ko-fi's privacy policy</a>. {site.name} does not receive your card number.
    </p>
    <h2>YouTube and Google</h2>
    <p>
      The channel's own upload tool uses Google OAuth only to upload and manage videos on the {site.name} channel.
      It accesses no other person's Google or YouTube data. The access token is stored privately. It is never shared
      or sold.
    </p>
    <p>
      Use of Google API data follows the
      <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>,
      including the Limited Use requirements.
    </p>
    <p>
      See also the <a href="https://www.youtube.com/t/terms">YouTube Terms of Service</a> and the
      <a href="https://policies.google.com/privacy">Google Privacy Policy</a>.
    </p>
    <h2>Revoke access</h2>
    <p>
      You can disconnect the upload tool on the
      <a href="https://myaccount.google.com/permissions">Google account permissions page</a>.
    </p>
    <h2>No sale of data</h2>
    <p>{site.name} does not sell personal data. That includes Google user data.</p>
    <h2>Contact</h2>
    <p>Questions about this policy: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </div>
</Base>
